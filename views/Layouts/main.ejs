      <span>Sistema de Biblioteca</span>
      <% if (locals.seccion) { %>
        <small> — <%= locals.seccion %></small>
      <% } %>
    </div>
    <nav>
      <a href="/">Inicio</a>
      <a href="/reservas">Reservas</a>
      <a href="/reservas/nueva">Nueva Reserva</a>
